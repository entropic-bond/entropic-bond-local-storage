{
  "name": "@entropic-bond/local-storage",
  "type": "module",
  "version": "1.0.0",
  "description": "LocalStorage plugin for Entropic Bond",
  "main": "./lib/entropic-bond-local-storage.umd.cjs",
  "module": "./lib/entropic-bond-local-storage.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/entropic-bond-local-storage.js",
      "require": "./lib/entropic-bond-local-storage.umd.cjs"
    }
  },
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "provenance": true
        }
      ],
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  },
  "scripts": {
    "test": "vitest",
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/entropic-bond/entropic-bond-local-storage.git"
  },
  "keywords": [
    "localStorage",
    "entropic bond"
  ],
  "author": "Josep Seto",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/entropic-bond/entropic-bond-local-storage/issues"
  },
  "homepage": "https://github.com/entropic-bond/entropic-bond-local-storage#readme",
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "entropic-bond": "^1.60.2",
    "happy-dom": "^20.14.0",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
